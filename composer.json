{
    "name": "kandoh/typo3-ext-lottie",
    "description": "TYPO3 CMS extension to enable rendering of Lottie/Bodymovin animations in frontend.",
    "type": "typo3-cms-extension",
    "keywords": [
        "TYPO3",
        "extension",
        "lottie",
        "bodymovin",
        "After Effects"
    ],
    "authors": [
        {
            "name": "theLine",
            "email": "typo3@theline.uber.space"
        },
        {
            "name": "Moritz Ngo",
            "email": "moritz.ngo@kandoh.de"
        }
    ],
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=7.4 || >=8.0",
        "typo3/cms-core": "^11.5",
        "typo3/cms-filemetadata": "^11.5",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.61",
        "helmich/typo3-typoscript-lint": "^2.0 || ^3.2",
        "php-parallel-lint/php-parallel-lint": "^1.0",
        "typo3/cms-backend": "*",
        "typo3/cms-filelist": "*",
        "typo3/cms-fluid-styled-content": "*",
        "typo3/cms-frontend": "*",
        "typo3/cms-impexp": "*",
        "typo3/cms-install": "*",
        "typo3/cms-lowlevel": "*",
        "typo3/cms-recordlist": "*",
        "typo3/cms-tstemplate": "*",
        "typo3/coding-standards": "^0.7 || ^0.8"
    },
    "autoload": {
        "psr-4": {
            "Kandoh\\Lottie\\": "Classes"
        }
    },
    "replace": {
        "theline/typo3-lottie": "self.version",
        "typo3-ter/lottie": "self.version"
    },
    "scripts": {
        "_cleanup": [
            "rm -rf .Build composer.lock"
        ],
        "lint": [
            "@lint:php",
            "@lint:typoscript"
        ],
        "lint:php": [
            "parallel-lint ./Classes/ ./Configuration/TCA/"
        ],
        "lint:typoscript": [
            "typoscript-lint -c Configuration/TypoScriptLintConfig.yaml -n --fail-on-warnings ./Configuration/TypoScript/"
        ],
        "code-check": [
            "@code-check:style"
        ],
        "code-check:style": [
            "php-cs-fixer fix --dry-run"
        ],
        "code-check:style:fix": [
            "php-cs-fixer fix"
        ]
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true
        }
    },
    "extra": {
        "typo3/cms": {
            "web-dir": ".Build",
            "extension-key": "lottie"
        }
    }
}
